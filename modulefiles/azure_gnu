#%Module
#
# Loads environment for building UPP on native Azure Cyclecloud
#

module use /shared/spack-stack/envs/ue-gcc9-az/modules/Core

if {![info exists ::env(LMOD_VERSION_MAJOR)]} {
    module load stack-gcc/9.2.0
    module load stack-openmpi/4.1.7a1
    module load cmake/3.31.7
    module load jasper/4.2.4
    module load zlib/1.2.11
    module load libpng/1.6.37
    module load hdf5/1.14.5
    module load netcdf-c/4.9.2
    module load netcdf-fortran/4.6.1
    module load bacio/2.6.0
    module load crtm/3.1.3
    module load g2/3.5.1
    module load g2tmpl/1.17.0
    module load ip/5.4.0
    module load w3emc/2.13.0
    module load nemsio/2.5.5
    module load sigio/2.3.3
    module load wrf-io/1.3.0
} else {
    depends-on stack-gcc/9.2.0
    depends-on stack-openmpi/4.1.7a1
    depends-on cmake/3.31.7
    depends-on jasper/4.2.4
    depends-on zlib/1.2.11
    depends-on libpng/1.6.37
    depends-on hdf5/1.14.5
    depends-on netcdf-c/4.9.2
    depends-on netcdf-fortran/4.6.1
    depends-on bacio/2.6.0
    depends-on crtm/3.1.3
    depends-on g2/3.5.1
    depends-on g2tmpl/1.17.0
    depends-on ip/5.4.0
    depends-on w3emc/2.13.0
    depends-on nemsio/2.5.5
    depends-on sigio/2.3.3
    depends-on wrf-io/1.3.0
